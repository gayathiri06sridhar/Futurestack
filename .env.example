DISCORD_BOT_TOKEN=your-discord-bot-token
DISCORD_GUILD_ID=
BACKEND_URL=http://127.0.0.1:8000
DISCORD_API_KEY=replace-with-a-long-random-discord-service-key

OCR_API_KEY=your-ocr-space-api-key
OCR_API_URL=https://api.ocr.space/parse/image

LLM_API_KEY=your-gemini-api-key
LLM_MODEL=gemini-3.8-flash
GEMINI_READ_TIMEOUT_SECONDS=180
EMBEDDING_PROVIDER=gemini
EMBEDDING_MODEL=gemini-embedding-001

# SQLite file is created automatically. Use an absolute path for deployment.
FUTURESTACK_DATABASE=
RATE_LIMIT_REQUESTS_PER_MINUTE=20
RETENTION_DAYS=365

# Configure an HMAC signing secret with at least 32 characters for production.
# Development creates a local sidecar key next to the SQLite database if unset.
AUDIT_HMAC_KEY=

# Optional actual ClamAV scan. Uploads are not malware-scanned when disabled.
MALWARE_SCANNER=disabled
CLAMSCAN_PATH=

ENVIRONMENT=development
ALLOW_REGISTRATION=true
INITIAL_ADMIN_EMAIL=
INITIAL_ADMIN_PASSWORD=
CORS_ALLOWED_ORIGINS=http://127.0.0.1:8000,http://localhost:8000
FUTURESTACK_BRAND_RULES=
